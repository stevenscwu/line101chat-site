# Model adapter: mock | ollama | openai-compatible
LLM_PROVIDER=mock
LLM_TIMEOUT_MS=20000

# Ollama (local development default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_TIMEOUT_MS=45000
# Optional bearer token for a protected hosted Ollama-compatible endpoint
OLLAMA_API_KEY=

# OpenAI-compatible provider (server-only)
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_MODEL=

# Dedicated LINE101 Avatar Messaging API channel (server-only)
LINE_AVATAR_CHANNEL_SECRET=
LINE_AVATAR_CHANNEL_ACCESS_TOKEN=

# Public LINE avatar CTA / QR settings
NEXT_PUBLIC_LINE_AVATAR_QR_URL=
NEXT_PUBLIC_LINE_AVATAR_ADD_FRIEND_URL=

# Avatar persona overrides
AVATAR_NAME=Celine
AVATAR_OWNER_NAME=LINE101Chat
AVATAR_CONTACT_URL=https://line101chat.com/contact
AVATAR_SYSTEM_PROMPT=

# Optional privacy-controlled conversation memory
# Use a long random value. Raw LINE IDs are HMAC-pseudonymized with this secret.
CELINE_MEMORY_SECRET=
CELINE_MEMORY_FILE=.data/celine-memory.json
CELINE_MEMORY_RETENTION_DAYS=90
CELINE_MEMORY_MAX_MESSAGES=40

# Optional durable Vercel memory through Upstash Redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Private Peak OS Executive Dashboard (all values are server-only).
PEAK_DASHBOARD_ENABLED=false
PEAK_DASHBOARD_OWNER_EMAILS=owner@example.com
# Format: pbkdf2-sha512$310000$<salt-base64url>$<digest-base64url>
PEAK_DASHBOARD_PASSWORD_HASH=
PEAK_DASHBOARD_SESSION_SECRET=
# Must match the local Peak OS PEAK_DASHBOARD_SYNC_SECRET.
PEAK_DASHBOARD_SYNC_SECRET=
PEAK_DASHBOARD_STALE_AFTER_MINUTES=30
# Durable private storage is mandatory in production. Connect a private Vercel Blob
# store to the project. Vercel supplies BLOB_READ_WRITE_TOKEN or OIDC credentials;
# never copy those managed values into this file.
