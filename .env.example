# LINE AI Avatar channel (use a dedicated LINE Messaging API channel)
LINE_AVATAR_CHANNEL_SECRET=
LINE_AVATAR_CHANNEL_ACCESS_TOKEN=

# LLM adapter: "mock" for deterministic demos, "ollama" for a live model
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b
OLLAMA_TIMEOUT_MS=45000

# Avatar persona
AVATAR_NAME=Celine
AVATAR_OWNER_NAME=LINE101Chat
AVATAR_CONTACT_URL=https://line101chat.com/contact
AVATAR_SYSTEM_PROMPT=

# Celine conversation memory
# Use a long random value. Raw LINE IDs are HMAC-hashed with this secret.
CELINE_MEMORY_SECRET=
CELINE_MEMORY_FILE=.data/celine-memory.json
CELINE_MEMORY_RETENTION_DAYS=90
CELINE_MEMORY_MAX_MESSAGES=40

# Durable Vercel memory (link Upstash Redis in Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public website CTA / QR settings
NEXT_PUBLIC_LINE_AVATAR_QR_URL=/celine-line-qr.png
NEXT_PUBLIC_LINE_AVATAR_ADD_FRIEND_URL=https://line.me/R/ti/p/%40821jpehj
