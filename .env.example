# All transfer credentials are SERVER ONLY. Never use NEXT_PUBLIC_ for them.
# Existing private Vercel Blob store; do not connect a public store.
BLOB_READ_WRITE_TOKEN=
# Existing Upstash/Vercel KV credentials also work as KV_REST_API_URL/TOKEN.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Generate separate random values (at least 32 characters each).
TRANSFER_SECRET=
CRON_SECRET=

# Account backend is OFF until project, schema, Auth settings and live tests are approved.
# Initial implementation accepts genuine Supabase bearer sessions (web or Android).
ACCOUNT_BACKEND=
SUPABASE_URL=
# Publishable key only (sb_publishable_...). NEVER use a secret/service-role key here.
SUPABASE_PUBLISHABLE_KEY=
